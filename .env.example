# Copy to .env and fill in real values. Never commit .env.

# ---------- Backend ----------
# Comma-separated key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-first-api-key,your-second-api-key
# LiteLLM model name used by every key unless LLM_MODELS is set.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional: one model per key (same order as LLM_API_KEYS) to mix providers, e.g.
# LLM_MODELS=gemini/gemini-3.5-flash-lite,groq/openai/gpt-oss-120b
LLM_MODELS=
# SQLite location (inside Docker this lives on the named volume mounted at /data).
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins allowed to call the backend.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# true enables the X-Simulate-Failure test hook (must be true on the deployed backend).
ENABLE_FAILURE_SIMULATION=true
# Default system prompt for sessions that do not provide one.
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# LiteLLM cache backend: local (in-memory) or disk.
CACHE_TYPE=local
CACHE_DIR=/data/litellm-cache
# Per-key provider timeout in seconds.
LLM_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# ---------- Frontend ----------
# Docker runtime: written into /config.js by the nginx entrypoint.
API_BASE_URL=http://localhost:8000
# Vite build-time fallback (used by Vercel / npm run dev).
VITE_API_BASE_URL=http://localhost:8000
